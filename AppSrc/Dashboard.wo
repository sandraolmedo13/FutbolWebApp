
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    // Dashboard principal de la aplicación de fútbol

    Set piMaxWidth to 1024
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24

        // Diseño adaptable a diferentes pantallas
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16

        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 12
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"

            // Tarjeta de entrenadores
            Object oTileEntrenadores is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Entrenadores</div></div>'

                WebRegisterPath ntNavigateForwardCustom oSelectEntrenador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // Tarjeta de jugadores
            Object oTileJugadores is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Jugadores</div></div>'

                WebRegisterPath ntNavigateForwardCustom oSelectJugador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // Tarjeta de posiciones
            Object oTilePosiciones is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Posiciones</div></div>'

                WebRegisterPath ntNavigateForwardCustom oSelectPosicion

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // Tarjeta de equipos
            Object oTileEquipos is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile DarkAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Equipos</div></div>'

                WebRegisterPath ntNavigateForwardCustom oSelectEquipo

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // Tarjeta de ligas
            Object oTileLigas is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Ligas</div></div>'

                WebRegisterPath ntNavigateForwardCustom oSelectLiga

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

        End_Object

    End_Object

    Procedure OnBeforeShow
        // Se ejecuta cada vez que se muestra el Dashboard
    End_Procedure

End_Object
